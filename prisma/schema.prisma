generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// OAuth-профиль GitHub или Google, привязанный к пользователю.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") // связывает имя поля в Prisma с другим именем столбца в PostgreSQL.
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // При удалении пользователя удаляются и его OAuth-привязки.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Один аккаунт провайдера нельзя привязать повторно.
  @@unique([provider, providerAccountId])
  @@map("accounts") // означает, что модель Account хранится в таблице accounts
}

// Серверная сессия хранит вход пользователя между запросами.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Основной пользователь; к нему могут относиться оба OAuth-провайдера.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  accounts Account[]
  sessions Session[]

  @@map("users")
}

// Одноразовый токен для будущего входа или подтверждения по email.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
